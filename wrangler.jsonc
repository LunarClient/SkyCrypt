{
    "name": "skyblock-web-view-lunarclient-com",
    "main": "./.cloudflare/worker.js",
    "site": {
        "bucket": "./.cloudflare/public"
    },
    "build": {
        "command": "pnpm run build"
    },
    "compatibility_date": "2026-01-23",
    "node_compat": true,
    "vars": {
